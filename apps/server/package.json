{
  "name": "@apiconfy/server",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "rm -rf dist && bun build src/index.ts --outdir dist --target bun",
    "clean": "rm -rf dist",
    "dev": "mkdir -p ../../data && bun run --watch src/index.ts",
    "lint": "echo 'lint ok'",
    "start": "bun run dist/index.js",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "test:watch": "bun test --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.4.0",
    "@opentelemetry/api": "^1.9.0",
    "drizzle-orm": "^0.40.0",
    "hono": "^4.7.0",
    "pino": "^9.6.0",
    "postgres": "^3.4.5",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/bun": "1.4.0",
    "pino-pretty": "^13.0.0"
  }
}
