# Apiconfy Environment Configuration
# Copy this file to .env.local and customize for your setup
# This file is committed to git as a template
# Reference: README.md "Environment Variables" section

# ============================================================================
# Server Configuration (Phase 0+)
# ============================================================================

# HTTP server port
PORT=3000

# Log level: trace, debug, info, warn, error, fatal
LOG_LEVEL=info

# ============================================================================
# Authentication (Phase 1+)
# ============================================================================

# Bearer token for /api/* routes
# If unset, all routes are open (warning logged at startup)
# API_KEY=your-secret-key-here

# When true, server refuses to start if API_KEY is missing
# Set this in production
# REQUIRE_API_KEY=true

# ============================================================================
# Database Configuration (Phase 0+ / Phase 3)
# ============================================================================

# Default engine: SQLite (local development). If DATABASE_URL is unset or empty
# the app runs on SQLite and logs a warning at startup — a single local file with
# no durability guarantees of its own. That is fine for local development and for
# replicated SQLite (Turso, LiteFS); use a server engine otherwise. Uncomment
# exactly ONE line below to select a real engine.
# (The `sqlite:` scheme is parsed from Phase 3; until then, leaving this unset
# also selects SQLite via SQLITE_PATH.)
DATABASE_URL=sqlite:./data/apiconfy.db

# Optional: SQLite file path when the sqlite URL omits a path
# SQLITE_PATH=./data/apiconfy.db

# PostgreSQL
# DATABASE_URL=postgres://user:pass@localhost:5432/apiconfy

# Oracle
# DATABASE_URL=oracle://user:pass@localhost:1521/ORCL

# MongoDB
# DATABASE_URL=mongodb://user:pass@localhost:27017/apiconfy

# Couchbase — the bucket is NOT part of the URL; credentials come from CB_USER/CB_PASS
# unless they are embedded in the URL.
# DATABASE_URL=couchbase://localhost
# CB_BUCKET=apiconfy
# CB_USER=Administrator
# CB_PASS=password

# Optional: persist per-invocation audit rows in execution_logs (off by default).
# When enabled, the engine's schema script must include the execution_logs block —
# uncomment it there BEFORE running the script; the startup probe then requires it.
# No automatic retention/purge yet (planned with Phase 5).
# ENABLE_DB_TRANSACTION_LOGS=true

# ============================================================================
# Observability (Phase 4+)
# ============================================================================

# OpenTelemetry OTLP endpoint for distributed tracing
# When set, OTel SDK activates and exports traces/metrics
# Supports: Dynatrace, Grafana Tempo, Jaeger, etc.
# See: plans/logging.md (Section 4: Distributed Tracing)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# ============================================================================
# Outbound TLS (Phase 3.6)
# ============================================================================

# Keep empty/unset. NODE_TLS_REJECT_UNAUTHORIZED=0 disables certificate verification for the
# whole process and would defeat request.ssl; the server ignores it at startup (warning logged)
# and the test runner unsets it. Skip verification per component with request.disableSSL instead.
NODE_TLS_REJECT_UNAUTHORIZED=
